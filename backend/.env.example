# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
# Copy this file to .env and fill in your real values

# ใส่ Gemini API Key ของคุณที่นี่ (ขอได้ฟรีที่ https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# โมเดล Gemini ที่ต้องการใช้ (เปลี่ยนได้ถ้า Google ปรับรุ่นโมเดลในอนาคต)
GEMINI_MODEL=gemini-2.5-flash

# พอร์ตที่ Backend จะรัน
PORT=3000
